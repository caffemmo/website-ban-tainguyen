YOUPROXY_ORDER_PATH=client/api/v1/order
YOUPROXY_IP_ADDRESS_PATH=client/api/v1/ipAddress
YOUPROXY_RENEW_PATH=client/api/v1/renew

SOCIAL_PROVIDER_BASE_URL=
