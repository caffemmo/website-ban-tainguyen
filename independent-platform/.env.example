APP_ENV=local
APP_URL=http://127.0.0.1:8080
APP_NAME=Caffemmo
APP_SECRET=replace-with-a-long-random-secret
APP_DEBUG=false

DB_HOST=db
DB_PORT=3306
DB_DATABASE=caffemmo
DB_USERNAME=caffemmo
DB_PASSWORD=change-me

SESSION_COOKIE=caffemmo_session
SESSION_SECURE=false

# Provider secrets chi doc o server. Khong commit gia tri that.
YOUPROXY_API_KEY=
